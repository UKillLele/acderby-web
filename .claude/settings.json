{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-plan-exists.mjs" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-bash.mjs" },
          { "type": "command", "command": "node .claude/hooks/guard-pr-review.mjs" }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-files.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/audit.mjs", "async": true }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node .claude/hooks/stop-gate.mjs" }]
      }
    ]
  }
}
